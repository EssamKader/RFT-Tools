<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Column"
        Height="680" Width="880"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">

    <!-- #86: the palette is NOT declared here. It lives in
         RFT.lib/SharedStyles.xaml, the same file the beam window merges,
         so the two tools cannot drift apart.

         The Source below is a PLACEHOLDER. rft.ui.shared_styles rewrites
         it to an absolute file:/// URI before this markup is parsed. That
         has to happen before the parse and not after, because every
         {StaticResource} in the styles below is resolved DURING the parse
         and StaticResource does not do forward references.

         Loading from a string leaves BaseUri null, so this must stay the
         only relative URI in the file. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tab chrome, copied in SHAPE from the beam window but not in
                 substance: the brushes come from the shared palette, so a
                 colour change repaints both. A Style is not shared, because
                 a Style describes the controls of the window it belongs to
                 (see tests/test_ui_shared_styles.py). -->
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabChrome"
                                    Background="{StaticResource SurfaceTint}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1,1,1,0"
                                    Margin="0,0,2,0" Padding="14,7,14,7">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background"
                                            Value="{StaticResource SkyBlue}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource InkPrimary}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabChrome" Property="Background"
                                            Value="{StaticResource SkyBlueHover}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="TabChrome" Property="Background"
                                            Value="{StaticResource SurfaceDisabled}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource InkDisabled}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource SkyBlueDeep}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
            </Style>

            <!-- A READ-OUT, not an input. #87 is explicit that the cover
                 display "must not look like an input" (A2: cover is read
                 from the element, never typed), and the same applies to
                 every derived number on this tab. No box, no border, no
                 white ground: a TextBlock that reads as text. -->
            <Style x:Key="ReadOut" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ReadOutLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                <Setter Property="Margin" Value="0,2,10,2"/>
            </Style>

            <!-- Where a read-out's PROVENANCE is shown. R5/R6: "2700 from a
                 soffit" and "2700 from a level elevation" are different
                 claims, and the window says which. -->
            <Style x:Key="ReadOutSource" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="Padding" Value="3,2,3,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The ground lives on the root Grid, not on the Window element: a
         Window's own attributes resolve BEFORE Window.Resources exists, so
         a StaticResource up there throws at load. The beam tool paid for
         this once (rc6) and the guard that caught it applies here too. -->
    <Grid Margin="8" Background="{StaticResource SurfaceWhite}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,2,8" TextWrapping="Wrap"
                   Text="Detail Column -- pick a column on the first tab. Every other tab stays disabled until a column is accepted: an out-of-scope column is refused with the reason, not detailed halfway."/>

        <TabControl x:Name="tabs" Grid.Row="1"
                    Background="{StaticResource SurfaceWhite}"
                    BorderBrush="{StaticResource BorderSubtle}">

            <TabItem Header="Column &amp; Materials">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Column"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- No Click attribute. Handlers are wired in
                                 script.py (self.pick_column_btn.Click += ...),
                                 which is the beam window's pattern: a window
                                 loaded from a STRING has no code behind, so a
                                 Click="name" attribute throws
                                 "Failed to create a 'Click' from the text" at
                                 parse time. Observed live on Revit 2024. -->
                            <Button x:Name="pick_column_btn" Content="Pick column..."
                                    Padding="12,5,12,5"/>
                            <TextBlock x:Name="column_status_tb"
                                       Style="{StaticResource ReadOut}"
                                       Margin="12,6,0,2"
                                       Text="No column picked yet."/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Family and type"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="type_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Section b x h"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="section_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="section_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Narrow / wide"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="narrow_wide_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource ReadOutSource}"
                                       Text="narrow governs S0 (section 4), wide governs L0 (section 3)"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cover (other faces)"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="cover_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="cover_source_tb"
                                       Style="{StaticResource ReadOutSource}"
                                       Text="read from the element, never typed (amendment A2)"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Base"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="base_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="base_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Top"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="top_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="top_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Clear height Hc"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="clear_height_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="clear_height_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>
                        </Grid>

                        <TextBlock x:Name="notes_tb"
                                   Style="{StaticResource ReadOutSource}"
                                   Margin="0,8,0,0" Text=""/>

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Materials"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- The labels carry the GRADE R7 requires, filled
                                 from rft.core.column_inputs.role_picker_label
                                 rather than typed here. The grade cannot be
                                 checked afterwards from the selected type, so
                                 it has to be in front of the engineer at the
                                 moment of choosing. -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       x:Name="main_bar_role_lbl"
                                       Text="Longitudinal bar type"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="main_bar_type_cb" IsEnabled="False"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       x:Name="tie_bar_role_lbl"
                                       Text="Tie bar type"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="tie_bar_type_cb" IsEnabled="False"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Longitudinal bars" x:Name="longitudinal_tab" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Bars per face (section 1)"/>
                        <!-- The corner-sharing statement is on screen, not
                             only in the docstring. The four faces SHARE their
                             corner bars, so a count that includes them is the
                             only one that reads off a drawing - and the total
                             below is what proves it was understood. -->
                        <TextBlock Style="{StaticResource ReadOutSource}"
                                   Text="Each count INCLUDES the two corner bars that face shares with its neighbours. The four corners are counted once in the total, not twice."/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       x:Name="b_face_lbl"
                                       Text="Bars per b-face (incl. corners)"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     x:Name="b_face_count_tb" Text="3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       x:Name="h_face_lbl"
                                       Text="Bars per h-face (incl. corners)"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     x:Name="h_face_count_tb" Text="4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Total longitudinal bars"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       x:Name="total_bars_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       x:Name="total_bars_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Splice length Ls (section 9)"/>
                        <TextBlock Style="{StaticResource ReadOutSource}"
                                   Text="NEVER auto-calculated. Ls varies with tension and compression zones, so the tool applies exactly what is entered here."/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ls"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     x:Name="ls_value_tb" Text="40"/>
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      x:Name="ls_mode_cb"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Ls applied"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="ls_applied_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="1" Grid.Column="3"
                                       x:Name="ls_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>
                        </Grid>

                        <Button x:Name="apply_longitudinal_btn"
                                Content="Apply" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Padding="12,5,12,5"/>
                        <TextBlock x:Name="longitudinal_status_tb"
                                   Style="{StaticResource ReadOutSource}"
                                   Margin="0,6,0,0" Text=""/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ties" x:Name="ties_tab" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Hook types (section 7)"/>
                        <!-- TWO dropdowns, structurally separate, so one
                             selection can never silently apply to the other
                             role. Both OPEN at 135 degrees - a default, not a
                             requirement: the user may pick any hook type the
                             project carries. -->
                        <TextBlock Style="{StaticResource ReadOutSource}"
                                   Text="Two independent choices. Both open at 135 degrees, which is a default and not a requirement - any hook type in the project may be selected for either role."/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Main outer tie hook"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="outer_hook_cb"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Inner tie hook"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="inner_hook_cb"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Tie arrangement (section 6.2)"/>
                        <!-- R17: the engineer STATES the topology and the tool
                             validates it. A text box rather than a list widget
                             with add/remove buttons - the whole arrangement is
                             visible and editable at once, it pastes between
                             columns, and it needs no widget state to stay in
                             step with the model. R17 chose subset entry because
                             it has no catalogue to maintain; a control with its
                             own hidden state would put one back. -->
                        <TextBlock Style="{StaticResource ReadOutSource}"
                                   Text="One tie per line: the bar numbers it touches. Two opposite bars make a cross-tie (1 6); three or more make a closed loop (0 1 2 3). The outer perimeter tie is implied and never typed. Bars are numbered anticlockwise from the bottom-left corner - see the Sketch tab."/>
                        <TextBox x:Name="tie_subsets_tb"
                                 Height="86" Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 Text=""/>
                        <!-- Section 6.1's verdict. Amber, not red: a refusal
                             here is the tool declining to place, which is a
                             different thing from the section 8 flags that are
                             warned and then built. -->
                        <TextBlock x:Name="tie_findings_tb"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerRed}"
                                   Text=""/>

                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Spacing (section 8)"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="mode_a_rb" Content="Mode A - auto"
                                         IsChecked="True" Margin="0,0,18,0"/>
                            <RadioButton x:Name="mode_b_rb" Content="Mode B - manual"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Confinement zone L0"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       x:Name="l0_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       x:Name="l0_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Code maximum S0"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="s0_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       x:Name="s0_source_tb"
                                       Style="{StaticResource ReadOutSource}" Text=""/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Confinement spacing to build"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="manual_confinement_tb"
                                     Text="" IsEnabled="False"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       x:Name="confinement_built_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Middle-zone spacing to build"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     x:Name="manual_middle_tb"
                                     Text="" IsEnabled="False"/>
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       x:Name="middle_built_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Middle-zone maximum"
                                       Style="{StaticResource ReadOutLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       x:Name="middle_max_tb"
                                       Style="{StaticResource ReadOut}" Text="--"/>
                            <TextBlock Grid.Row="4" Grid.Column="2"
                                       Style="{StaticResource ReadOutSource}"
                                       Text="2 x S0 (section 5). There is deliberately no 150 mm cap here."/>
                        </Grid>

                        <!-- The section 8 flags. Amber, never red: a Mode B
                             violation is WARNED and then BUILT, so painting it
                             as a failure would misdescribe what happens next. -->
                        <TextBlock x:Name="spacing_flags_tb"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningAmber}"
                                   Text=""/>

                        <Button x:Name="apply_ties_btn"
                                Content="Apply" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Padding="12,5,12,5"/>
                        <TextBlock x:Name="ties_status_tb"
                                   Style="{StaticResource ReadOutSource}"
                                   Margin="0,6,0,0" Text=""/>

                        <TextBlock Style="{StaticResource ReadOutSource}"
                                   Margin="0,14,0,0"
                                   Text="Tie topology (section 6.2 - which bars each closed loop wraps) is issue #89, blocked on open question Q11."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- #90. A FIFTH tab: #87 described a four-tab shell, and this
                 is an addition to it rather than a rearrangement. The cross
                 section and the zone strip share no scale, so they get two
                 canvases rather than one overlay that would misrepresent
                 both. -->
            <TabItem Header="Sketch" x:Name="sketch_tab" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceWhite}">
                        <!-- Background="Transparent" is NOT decoration and
                             looks like a no-op against the white Border
                             behind it, so do not delete it. A WPF Canvas
                             with no Background of its own is not hit
                             testable over its empty area: only a filled
                             child (the bar Ellipses) raises
                             MouseLeftButtonDown, so without this every
                             near-miss click #137's BAR_PICK_RADIUS_PX
                             exists to catch would never reach the
                             handler. -->
                        <Canvas x:Name="section_canvas" ClipToBounds="True"
                                Background="Transparent"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,0"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceWhite}">
                        <Canvas x:Name="strip_canvas" ClipToBounds="True"/>
                    </Border>

                    <!-- #137: sketch the tie by clicking its bars, instead
                         of typing their numbers. Click bars in
                         section_canvas above (wired in script.py, not
                         here, since a string-loaded window has no code
                         behind); this row shows what has been clicked so
                         far and commits it. The Ties text box stays the
                         authoritative source: this row only ever WRITES a
                         line into it, the same line typing would have
                         produced. -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <TextBlock x:Name="tie_selection_caption_tb"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SelectionPurple}"
                                   FontWeight="Bold"
                                   Margin="0,0,12,0" Text=""/>
                        <Button x:Name="add_tie_btn" Content="Add tie"
                                Padding="10,4,10,4" Margin="0,0,8,0"/>
                        <Button x:Name="clear_selection_btn"
                                Content="Clear selection"
                                Padding="10,4,10,4"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               x:Name="sketch_captions_tb"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}"
                               Text=""/>
                </Grid>
            </TabItem>

            <TabItem Header="Review" x:Name="review_tab" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="build_report_btn" Content="Build report"
                                Padding="12,5,12,5"/>
                        <TextBlock x:Name="review_status_tb"
                                   Style="{StaticResource ReadOutSource}"
                                   Margin="12,6,0,0"
                                   Text="Apply the bar and tie inputs first."/>
                    </StackPanel>

                    <!-- #120 (A3, R23/R25): the Apply path. A second press
                         on a column that already carries this tool's own
                         reinforcement DELETES it and rebuilds, inside one
                         transaction; see rft.revit.column_placer. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button x:Name="apply_place_btn" Content="Apply"
                                Padding="12,5,12,5"/>
                        <TextBlock x:Name="place_status_tb"
                                   Style="{StaticResource ReadOutSource}"
                                   Margin="12,6,0,0" TextWrapping="Wrap"
                                   Text="Apply the bar and tie inputs first."/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,8,0,6" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}"
                               Text="Read this before placing. Every number here comes from the same computation the placer will use, so the page and the model cannot disagree."/>

                    <!-- A read-only TextBox, not a TextBlock: the report is
                         meant to be selected and copied into a transmittal,
                         and a TextBlock cannot be. Monospace because the tie
                         level table is columnar and proportional digits
                         destroy it. -->
                    <TextBox Grid.Row="3" x:Name="report_tb"
                             IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource SurfaceTint}"
                             BorderBrush="{StaticResource BorderSubtle}"
                             Text=""/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="status_tb" Grid.Row="2" Margin="2,8,2,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource InkMuted}"
                   Text="ready"/>
    </Grid>
</Window>
