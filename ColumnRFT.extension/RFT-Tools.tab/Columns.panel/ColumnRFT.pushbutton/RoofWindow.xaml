<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top floor termination"
        Height="620" Width="760"
        MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">

    <!-- R43: the top-floor inputs live in their own window. It opens when
         the top-floor box is ticked (R36) and closes when it is unticked,
         dropping everything it held: no top-floor state survives an
         unticked box, or the tool carries something the report does not
         show.

         This window OWNS THE INPUTS; the main window owns the plan. It
         hands back one object and keeps no plan state of its own, because
         two windows each holding a copy is how they drift, and the drift
         would show up as a cage rather than as an error.

         The Source below is a PLACEHOLDER, rewritten to an absolute
         file:/// URI by rft.ui.shared_styles BEFORE this markup is
         parsed == every {StaticResource} below is resolved DURING the
         parse and StaticResource does not do forward references. Loading
         from a string leaves BaseUri null, so this must stay the only
         relative URI in the file. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,2"/>
            </Style>

            <Style x:Key="ReadOutLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
                <Setter Property="Margin" Value="0,4,8,2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ReadOut" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
                <Setter Property="Margin" Value="0,4,8,2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Where a number CAME FROM, never merged into the number
                 itself: "read from the slab" and "typed by the engineer"
                 are different claims (R38), and a report that cannot tell
                 them apart cannot be checked. -->
            <Style x:Key="ReadOutSource" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="Padding" Value="3,2,3,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The ground lives on the root Grid, not on the Window element: a
         Window's own attributes resolve BEFORE Window.Resources exists, so
         a StaticResource up there throws at load. The beam tool paid for
         this once (rc6). -->
    <Grid Margin="8" Background="{StaticResource SurfaceWhite}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,2,8" TextWrapping="Wrap"
                   Text="This column has no storey above it, so its bars cannot lap into one. They bend into the floor above instead. Nothing here is guessed: the slab is read from the model, the runs are measured, and the development length is yours to state."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,2,0">

                <!-- ====================================== the slab -->
                <TextBlock Style="{StaticResource SectionHeading}"
                           Text="The floor above (read from the model)"/>
                <TextBlock Style="{StaticResource ReadOutSource}"
                           Text="Roofs are modelled as floors, which is the right call for a structural element, so this is the top floor rather than a separate roof object."/>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="floor_tb"
                               Style="{StaticResource ReadOut}" Text="--"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               x:Name="floor_source_tb"
                               Style="{StaticResource ReadOutSource}" Text=""/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Slab thickness"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="slab_thickness_tb"
                               Style="{StaticResource ReadOut}" Text="--"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               x:Name="slab_thickness_source_tb"
                               Style="{StaticResource ReadOutSource}" Text=""/>

                    <!-- R38: the cover is READ when the slab has one, and
                         the typed box opens ONLY when the slab reads
                         zero, which R38 treats as nobody having set one.
                         A typed box that is always open invites a number
                         that disagrees with the model. -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Slab cover"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="slab_cover_tb"
                               Style="{StaticResource ReadOut}" Text="--"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               x:Name="slab_cover_source_tb"
                               Style="{StaticResource ReadOutSource}" Text=""/>
                </Grid>

                <StackPanel x:Name="typed_cover_panel" Visibility="Collapsed"
                            Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Cover to state (mm)" Width="210"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBox x:Name="typed_cover_tb" Width="110" Text=""/>
                    <TextBlock Margin="10,0,0,0"
                               Style="{StaticResource ReadOutSource}"
                               Text="This floor's own cover reads zero, so there is nothing to read. State it and the report will say it was typed."/>
                </StackPanel>

                <!-- ============================ development length -->
                <TextBlock Style="{StaticResource SectionHeading}"
                           Text="Development length L_D (section 1)"/>
                <TextBlock Style="{StaticResource ReadOutSource}"
                           Text="R35: NEVER picked by the tool, and never inherited from the beam. State a multiplier of the bar diameter (60 means 60 x diameter) or a plain length in millimetres."/>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="L_D"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="ld_value_tb" Text=""/>
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              x:Name="ld_mode_cb"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="L_D applied"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="ld_applied_tb"
                               Style="{StaticResource ReadOut}" Text="--"/>
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               x:Name="ld_source_tb"
                               Style="{StaticResource ReadOutSource}" Text=""/>
                </Grid>

                <!-- ================================ free edges, S3 -->
                <TextBlock Style="{StaticResource SectionHeading}"
                           Text="Free edges (section 3)"/>
                <TextBlock Style="{StaticResource ReadOutSource}"
                           Text="Every face defaults to slab-continuing, and the run beyond it is MEASURED from the model. Tick a face only where the slab genuinely STOPS at the column and the model does not show it."/>

                <Button x:Name="pick_free_edges_btn" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Padding="12,5,12,5"
                        Content="Pick the faces in the model..."/>
                <TextBlock Style="{StaticResource ReadOutSource}"
                           Text="Click the column faces where the slab stops, then Finish. The tool works out which face is which -- +Hand and -Facing are its own frame, not anything you can see in a view. Picking REPLACES the ticks below; Escape leaves them alone."/>

                <TextBlock Style="{StaticResource ReadOutSource}"
                           Margin="0,6,0,0"
                           Text="What a tick changes: the bar stops using the room BEYOND that face and uses the room INSIDE the column instead -- the face width less twice the slab cover (section 2's b_E cap). That is a different measurement from a different origin, so the number can go UP as well as down. The face is also recorded as a FLAGGED free edge, so section 4 says the leg was shortened by a declared edge rather than by a boundary the tool measured. Tick, then press Read the slab again to see the new numbers."/>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Face"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Slab stops here"
                               Style="{StaticResource ReadOutLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Measured run (R42)"
                               Style="{StaticResource ReadOutLabel}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="+Hand"
                               Style="{StaticResource ReadOutLabel}"/>
                    <CheckBox Grid.Row="1" Grid.Column="1"
                              x:Name="free_plus_hand_cb" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               x:Name="run_plus_hand_tb"
                               Style="{StaticResource ReadOutSource}" Text="--"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="-Hand"
                               Style="{StaticResource ReadOutLabel}"/>
                    <CheckBox Grid.Row="2" Grid.Column="1"
                              x:Name="free_minus_hand_cb" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               x:Name="run_minus_hand_tb"
                               Style="{StaticResource ReadOutSource}" Text="--"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="+Facing"
                               Style="{StaticResource ReadOutLabel}"/>
                    <CheckBox Grid.Row="3" Grid.Column="1"
                              x:Name="free_plus_facing_cb" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               x:Name="run_plus_facing_tb"
                               Style="{StaticResource ReadOutSource}" Text="--"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="-Facing"
                               Style="{StaticResource ReadOutLabel}"/>
                    <CheckBox Grid.Row="4" Grid.Column="1"
                              x:Name="free_minus_facing_cb" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="2"
                               x:Name="run_minus_facing_tb"
                               Style="{StaticResource ReadOutSource}" Text="--"/>
                </Grid>

                <!-- ============================ what will be built -->
                <TextBlock Style="{StaticResource SectionHeading}"
                           Text="What will be built"/>
                <TextBlock Style="{StaticResource ReadOutSource}"
                           Text="R44: a face run bends OUT OF ITS OWN FACE, never sideways along it, so the four runs are stated separately. The achieved length is the BUILT centreline after Revit's fillet loss (R40), not the nominal legs."/>

                <TextBlock x:Name="preview_tb" Margin="0,6,0,0"
                           Style="{StaticResource ReadOut}"
                           FontFamily="Consolas" Text="--"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================================== the footer -->
        <StackPanel Grid.Row="2" Margin="2,10,2,0">
            <TextBlock x:Name="roof_status_tb"
                       Style="{StaticResource ReadOutSource}" Text=""/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="read_slab_btn" Content="Read the slab again"
                        Padding="12,5,12,5"/>
                <Button x:Name="use_btn" Content="Use these inputs"
                        Margin="10,0,0,0" Padding="12,5,12,5"
                        IsEnabled="False"/>
                <Button x:Name="cancel_btn" Content="Cancel"
                        Margin="10,0,0,0" Padding="12,5,12,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
